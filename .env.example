# ==========================================
# IMPÉRIO STREETWEAR - Configuração de Ambiente
# ==========================================
# Copie este arquivo para .env e preencha as variáveis locais.
# NUNCA comite o arquivo .env no controle de versão!

# Servidor
PORT=3000
NODE_ENV=development
STORE_NAME="IMPÉRIO STREETWEAR"
STORE_URL=http://localhost:3000

# Chave Secreta para Sessão/JWT do Painel Admin (Gere uma chave longa e aleatória)
JWT_SECRET=imperio_secret_key_change_this_in_production_jwt_2026_xyz987

# Credenciais Iniciais de Administrador (Criadas no primeiro setup caso não existam)
# OBRIGATÓRIO trocar a senha após o primeiro login!
ADMIN_EMAIL=KEVIn2018.@imperio.local
ADMIN_INITIAL_PASSWORD=KEVIn2018.

# Contato Comercial / WhatsApp
# Formato: código do país + DDD + número (ex: 5511999999999)
WHATSAPP_NUMBER=55 16999748661
WHATSAPP_DEFAULT_MESSAGE="Olá! Gostaria de mais informações sobre os produtos da Império Streetwear."

# Banco de Dados SQLite Local
DB_PATH=./data/imperio.db

# Mercado Pago - Checkout Transparente / Pix / Cartão
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# No modo de testes, deixe em branco para rodar com o Mock/Simulador integrado de pagamentos.
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
